# Copy to .env and fill in. The defaults below are tuned for local dev:
# Postgres on localhost, filesystem storage, dev-stub Stripe, console-logged email.

DATABASE_URL="postgresql://USER@localhost:5432/kidsforkids_db?schema=public"

# Object storage. Leave MINIO_* blank (or set STORAGE_BACKEND=local) to use ./storage.
# MINIO_ENDPOINT="http://localhost:9000"
# MINIO_ACCESS_KEY=""
# MINIO_SECRET_KEY=""
MINIO_BUCKET_PUBLIC="public-assets"
MINIO_BUCKET_PRIVATE="private-stl"
STORAGE_BACKEND="local"

# Auth.js — generate via: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Stripe — leave placeholder to run the dev stub (auto-paid).
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"

# Postmark — leave placeholder to log emails to console.
POSTMARK_SERVER_TOKEN="your_postmark_server_token"
POSTMARK_FROM_EMAIL="hello@example.com"

SEED_ADMIN_PASSWORD="change-me-now"
